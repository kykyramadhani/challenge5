<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Language *identifiers*, matching the .lproj folders the string
	     catalog compiles to. "indonesia" is the enum case's name, not a
	     language code, and the system does not recognise it. -->
